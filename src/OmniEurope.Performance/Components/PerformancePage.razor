@namespace OmniEurope.Performance.Components
@* The page MapOmniPerformance answers with: a complete HTML document, no stylesheet, no script, the figures in
   semantic HTML without a single class or style. They are read once per request; reloading the page reads them
   again. A host that wants its own look renders RequestPerformanceRecorder.Summarize() itself. *@
<!DOCTYPE html>
<html lang="@Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@L["Title"]</title>
</head>
<body>
    <main>
        <h1>@L["Title"]</h1>
        <p>@L["WindowScope"]</p>
        @if (_summary.Slowest.Count == 0)
        {
            <p>@L["NoSamples"]</p>
        }
        else
        {
            <section aria-labelledby="omni-performance-slowest">
                <h2 id="omni-performance-slowest">@L["Slowest"]</h2>
                <p>@string.Format(CultureInfo.CurrentCulture, L["SlowestScope"], PerformanceFormat.Utc(_summary.WindowStart))</p>
                <table>
                    <thead>
                        <tr>
                            <th scope="col">@L["Duration"]</th>
                            <th scope="col">@L["Method"]</th>
                            <th scope="col">@L["Route"]</th>
                            <th scope="col">@L["Status"]</th>
                            <th scope="col">@L["Date"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var call in _summary.Slowest)
                        {
                            <tr>
                                <td>@PerformanceFormat.Milliseconds(call.DurationMs)</td>
                                <td>@call.Method</td>
                                <td><code>@call.Route</code></td>
                                <td>@call.StatusCode</td>
                                <td><time datetime="@call.At.ToString("O", CultureInfo.InvariantCulture)">@PerformanceFormat.Utc(call.At)</time></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>

            <section aria-labelledby="omni-performance-routes">
                <h2 id="omni-performance-routes">@L["ByRoute"]</h2>
                @if (_summary.Since is { } since)
                {
                    <p>@string.Format(CultureInfo.CurrentCulture, L["Window"], _summary.SampleCount.ToString("N0", CultureInfo.CurrentCulture), PerformanceFormat.Utc(since))</p>
                }
                @if (_summary.Truncated)
                {
                    <p>@L["Truncated"]</p>
                }
                <table>
                    <thead>
                        <tr>
                            <th scope="col">@L["Method"]</th>
                            <th scope="col">@L["Route"]</th>
                            <th scope="col">@L["Calls"]</th>
                            <th scope="col">@L["P50"]</th>
                            <th scope="col">@L["P95"]</th>
                            <th scope="col">@L["P99"]</th>
                            <th scope="col">@L["Max"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var route in _summary.Routes)
                        {
                            <tr>
                                <td>@route.Method</td>
                                <td><code>@route.Route</code></td>
                                <td>@route.Count.ToString("N0", CultureInfo.CurrentCulture)</td>
                                <td>@PerformanceFormat.Milliseconds(route.P50Ms)</td>
                                <td>@PerformanceFormat.Milliseconds(route.P95Ms)</td>
                                <td>@PerformanceFormat.Milliseconds(route.P99Ms)</td>
                                <td>@PerformanceFormat.Milliseconds(route.MaxMs)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    </main>
</body>
</html>

@code {
    private RequestPerformanceSummary _summary = default!;

    [Inject] private RequestPerformanceRecorder Recorder { get; set; } = default!;
    [Inject] private IStringLocalizer<PerformanceStrings> L { get; set; } = default!;

    /// <summary>The language of the texts: the UI culture's, or French, the neutral language, under the
    /// invariant culture (whose two-letter name, "iv", is no language).</summary>
    internal static string Language => CultureInfo.CurrentUICulture.Name.Length == 0
        ? "fr"
        : CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    /// <inheritdoc />
    protected override void OnInitialized() => _summary = Recorder.Summarize();
}
